---
import Logo from "./Logo.astro";

const socials = [
  { href: "#", label: "Instagram", icon: "/social-instagram.svg" },
  { href: "#", label: "Social profile 2", icon: "/social-video.svg" },
  { href: "#", label: "Social profile 3", icon: "/social-facebook.svg" },
];
---

<footer class="site-footer" id="contact">
  <div class="wrap inner">
    <Logo size="sm" />

    <p class="copyright">&copy; 2026</p>

    <ul class="socials">
      {socials.map(({ href, label, icon }) => (
        <li>
          <a href={href} aria-label={label}>
            <img src={icon} alt="" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    height: var(--size-footer-height);
    background: var(--color-footer);
    color: var(--color-ink-inverse);
    padding-block: var(--sp-footer);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: flex-end;
    height: var(--size-logo-height);
  }

  .copyright {
    font-size: var(--type-body-18);
    line-height: var(--lh-snug);
    color: var(--color-footer-muted);
    white-space: nowrap;
  }

  .socials {
    display: flex;
    justify-self: end;
    gap: var(--sp-sm);
    list-style: none;
  }

  .socials a {
    display: block;
    width: var(--size-social-icon);
    height: var(--size-social-icon);
  }

  .socials img { width: 100%; height: 100%; }

  @media (max-width: 900px) {
    .site-footer { height: auto; }

    .inner {
      grid-template-columns: 1fr;
      justify-items: center;
      height: auto;
      gap: var(--sp-med);
    }

    .socials { justify-self: center; }
  }
</style>
