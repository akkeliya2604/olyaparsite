---
import Logo from "./Logo.astro";

const socials = [
  { href: "#", label: "Instagram", icon: "/social-instagram.svg" },
  { href: "#", label: "Social profile 2", icon: "/social-video.svg" },
  { href: "#", label: "Social profile 3", icon: "/social-facebook.svg" },
];
---

<footer class="site-footer" id="contact">
  <div class="wrap inner">
    <Logo size="sm" />

    <p class="copyright">&copy; 2026</p>

    <ul class="socials">
      {socials.map(({ href, label, icon }) => (
        <li>
          <a href={href} aria-label={label}>
            <img src={icon} alt="" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer);
    color: var(--white);
    padding-block: var(--sp-footer);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-med);
    flex-wrap: wrap;
  }

  .copyright {
    font-size: var(--type-body-16);
    color: var(--mist);
  }

  .socials {
    display: flex;
    gap: var(--sp-sm);
    list-style: none;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--white) 10%, transparent);
    color: var(--white);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .socials a:hover { background: var(--color-accent); }
  .socials img { width: 16px; height: 16px; }
</style>
