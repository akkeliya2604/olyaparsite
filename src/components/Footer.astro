---
import Logo from "./Logo.astro";

// TODO(figma): the design shows three identical glyphs with no destinations,
// which reads as placeholder. Real platforms and URLs needed before launch.
const socials = [
  { href: "#", label: "Instagram" },
  { href: "#", label: "Social profile 2" },
  { href: "#", label: "Social profile 3" },
];
---

<footer class="site-footer" id="contact">
  <div class="wrap inner">
    <Logo size="sm" />

    <p class="copyright">&copy; 2026</p>

    <ul class="socials">
      {socials.map(({ href, label }) => (
        <li>
          <a href={href} aria-label={label}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--white);
    padding-block: var(--sp-lg);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-med);
    flex-wrap: wrap;
  }

  .copyright {
    font-size: var(--type-body-16);
    color: var(--mist);
  }

  .socials {
    display: flex;
    gap: var(--sp-sm);
    list-style: none;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.10);
    color: var(--white);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .socials a:hover { background: var(--color-accent); }
</style>
