---
interface Props {
  /** Nav uses the compact lockup; the footer uses the same at larger scale. */
  size?: "sm" | "md";
}
const { size = "sm" } = Astro.props;
---

<a href="/" class:list={["logo", `logo--${size}`]} aria-label="Maya Reynolds — home">
  <img src="/logo-mark-light.svg" alt="" class="mark" aria-hidden="true" />
  <span class="name">
    <span>Maya</span>
    <span class="underline">Reynolds</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-paragraph);
    text-decoration: none;
    color: var(--color-text);
  }

  .mark { width: 52px; height: auto; }

  .name {
    display: flex;
    flex-direction: column;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .underline { border-bottom: 1px solid currentColor; }

  .logo--sm .name { font-size: 0.75rem; }

  .logo--md .mark { width: 75px; }
  .logo--md .name { font-size: 0.875rem; }
</style>
