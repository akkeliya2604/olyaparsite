---
interface Props {
  /** Nav uses the compact lockup; the footer uses the same at larger scale. */
  size?: "sm" | "md";
}
const { size = "sm" } = Astro.props;
---

<a href="/" class:list={["logo", `logo--${size}`]} aria-label="Maya Reynolds — home">
  <img src="/logo-mark-light.svg" alt="" class="mark" aria-hidden="true" />
  <img src="/logo-accent-light.svg" alt="" class="detail" aria-hidden="true" />
  <span class="name">
    <span>Maya</span>
    <span>Reynolds</span>
  </span>
</a>

<style>
  .logo {
    position: relative;
    display: block;
    flex: none;
    width: var(--size-logo-width);
    height: var(--size-logo-height);
    text-decoration: none;
    color: var(--color-text);
  }

  .mark {
    position: absolute;
    top: var(--pos-logo-mark-top);
    left: 0;
    width: var(--size-logo-mark-width);
    height: var(--size-logo-mark-height);
  }

  .detail {
    position: absolute;
    top: 0;
    left: var(--pos-logo-detail-left);
    width: var(--size-logo-detail-width);
    height: var(--size-logo-detail-height);
  }

  .name {
    position: absolute;
    inset: 0;
    font-weight: 700;
    line-height: 1;
  }

  .name span {
    position: absolute;
    left: var(--pos-logo-name-left);
    white-space: nowrap;
  }

  .name span:first-child {
    top: var(--pos-logo-name-first-top);
    font-size: var(--size-logo-name-first);
  }

  .name span:last-child {
    top: var(--pos-logo-name-second-top);
    font-size: var(--size-logo-name-second);
  }
</style>
