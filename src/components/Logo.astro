---
/**
 * TODO(figma): typographic reconstruction, not the exported asset.
 * The design's "MR" monogram did not come back from download_assets — the
 * node has >20 source images and the logo fell outside the first 20, and
 * no SVG layers were surfaced. Replace with the real export when available;
 * see docs/figma-to-web.md.
 */
interface Props {
  /** Nav uses the compact lockup; the footer uses the same at larger scale. */
  size?: "sm" | "md";
}
const { size = "sm" } = Astro.props;
---

<a href="/" class:list={["logo", `logo--${size}`]} aria-label="Maya Reynolds — home">
  <span class="mark" aria-hidden="true">MR</span>
  <span class="name">
    <span>Maya</span>
    <span class="underline">Reynolds</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
  }

  .mark {
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .name {
    display: flex;
    flex-direction: column;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .underline { border-bottom: 1.5px solid currentColor; }

  .logo--sm .mark { font-size: 2rem; }
  .logo--sm .name { font-size: 0.75rem; }

  .logo--md .mark { font-size: 2.5rem; }
  .logo--md .name { font-size: 0.875rem; }
</style>
