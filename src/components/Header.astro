---
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const links = [
  { href: "#top", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#course", label: "Course" },
  { href: "#work-with-maya", label: "Work With Maya" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="wrap bar">
    <Logo />

    <nav id="site-nav" aria-label="Main">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <Button href="#masterclass" size="sm" class="cta">Free Masterclass</Button>

    <button
      type="button"
      class="toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  // The design is desktop-only; this is the minimum needed to keep the nav
  // usable below 900px. aria-expanded is the single source of truth for state.
  const toggle = document.querySelector<HTMLButtonElement>(".toggle");
  const header = document.querySelector<HTMLElement>(".site-header");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    header?.classList.toggle("is-open", !open);
  });

  // Close after following an in-page link, or the panel covers the target.
  document.querySelectorAll("#site-nav a").forEach((a) =>
    a.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      header?.classList.remove("is-open");
    })
  );
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    padding-block: var(--sp-med);
    color: var(--white);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-lg);
  }

  nav { margin-inline: auto; }

  nav ul {
    display: flex;
    gap: var(--sp-med);
    list-style: none;
  }

  nav a {
    font-size: 0.875rem;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  nav a:hover { opacity: 1; }

  .toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .toggle span {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 900px) {
    .bar { flex-wrap: wrap; }
    .toggle { display: flex; margin-left: auto; }
    .cta { display: none; }

    nav {
      order: 3;
      flex-basis: 100%;
      margin-inline: 0;
      display: none;
    }

    :global(.site-header.is-open) nav { display: block; }

    nav ul {
      flex-direction: column;
      gap: var(--sp-sm);
      padding-block: var(--sp-sm);
    }
  }
</style>
