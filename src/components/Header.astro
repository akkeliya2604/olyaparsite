---
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const links = [
  { href: "#top", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#course", label: "Course" },
  { href: "#work-with-maya", label: "Work With Maya" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="wrap bar">
    <Logo />

    <nav id="site-nav" aria-label="Main">
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a href={href}>
              <span>{label}</span>
              <img src="/nav-hover-underline.svg" alt="" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <Button href="#masterclass" size="sm" tone="accent" class="cta">Free Masterclass</Button>

    <button
      type="button"
      class="toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  // The design is desktop-only; this is the minimum needed to keep the nav
  // usable below 900px. aria-expanded is the single source of truth for state.
  const toggle = document.querySelector<HTMLButtonElement>(".toggle");
  const header = document.querySelector<HTMLElement>(".site-header");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    header?.classList.toggle("is-open", !open);
  });

  // Close after following an in-page link, or the panel covers the target.
  document.querySelectorAll("#site-nav a").forEach((a) =>
    a.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      header?.classList.remove("is-open");
    })
  );
</script>

<style>
  .site-header {
    position: absolute;
    inset: calc(var(--sp-footer) + var(--sp-sm)) 0 auto;
    z-index: 20;
    color: var(--color-ink-inverse);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-nav);
  }

  nav { margin-inline: auto; }

  nav ul {
    display: flex;
    gap: var(--sp-nav);
    list-style: none;
  }

  nav a {
    position: relative;
    display: block;
    font-size: var(--type-body-16);
    line-height: var(--lh-snug);
    text-decoration: none;
  }

  nav a img {
    position: absolute;
    top: calc(100% + var(--sp-micro));
    left: 0;
    width: var(--size-nav-underline-width);
    height: var(--size-nav-underline-height);
    max-width: none;
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition:
      opacity var(--duration-nav) var(--ease-linear),
      transform var(--duration-nav) var(--ease-linear);
  }

  nav a:hover img,
  nav a:focus-visible img {
    opacity: 1;
    transform: scaleX(1);
  }

  .toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-menu-lines);
    width: var(--size-menu-control);
    height: var(--size-menu-control);
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }

  .toggle span {
    display: block;
    height: var(--size-menu-line);
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 900px) {
    .site-header { inset-block-start: var(--sp-sm); }
    .bar { flex-wrap: wrap; }
    .toggle { display: flex; margin-left: auto; }
    .site-header :global(.cta) { display: none; }

    nav {
      order: 3;
      flex-basis: 100%;
      margin-inline: 0;
      display: none;
      padding: var(--sp-sm);
      background: var(--color-surface-dark);
      border-radius: var(--radius-md);
    }

    :global(.site-header.is-open) nav { display: block; }

    nav ul {
      flex-direction: column;
      gap: var(--sp-sm);
      padding-block: var(--sp-sm);
    }
  }
</style>
