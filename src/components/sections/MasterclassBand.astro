---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import bg from "../../assets/masterclass-bg-figma.png";

/**
 * TODO(figma): this section reads "Competitive Soccer Players" in the design
 * while the entire rest of the page is about swimming — and the frame's own
 * source images include a soccer team photo. It is leftover template copy.
 * Built as designed so the implementation matches the file; fix in Figma and
 * this block becomes a two-word change.
 */
---

<section class="masterclass band-dark" id="masterclass">
  <div class="background" aria-hidden="true">
    <Image src={bg} alt="" widths={[1200, 1920]} sizes="100vw" />
  </div>
  <div class="blur" aria-hidden="true"></div>

  <div class="wrap inner">
    <h2>
      The Mental <em class="accent">Game Blueprint</em><br />
      for Competitive Soccer Players
    </h2>

    <p>
      A free training for athletes and parents. Learn why talent alone is not
      enough, and how competitive soccer players build confidence, composure,
      focus, and resilience with a simple mental performance system.
    </p>

    <Button href="#contact">Send Me the Free Masterclass</Button>
  </div>
</section>

<style>
  .masterclass {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    height: var(--size-masterclass-height);
    overflow: hidden;
  }

  .background {
    position: absolute;
    top: 0;
    left: var(--pos-masterclass-bg-left);
    width: var(--size-masterclass-bg-width);
    height: var(--size-masterclass-bg-height);
    overflow: hidden;
  }

  .background :global(img) {
    position: absolute;
    top: -37.08%;
    left: 0.01%;
    width: 99.99%;
    height: var(--size-masterclass-image-height);
    max-width: none;
  }

  .background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-overlay-base), transparent 6.826%);
  }

  .blur {
    position: absolute;
    top: var(--pos-masterclass-blur-top);
    left: var(--pos-masterclass-blur-left);
    width: var(--size-masterclass-blur-width);
    height: var(--size-masterclass-blur-height);
    background: var(--color-surface-dark);
    opacity: 0.6;
    filter: blur(var(--size-masterclass-blur-radius));
  }

  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  h2 {
    width: var(--size-masterclass-copy);
    font-size: var(--type-h2);
  }

  .inner p {
    width: var(--size-masterclass-copy);
    margin-top: var(--sp-med);
    font-size: var(--type-body-18);
    line-height: var(--lh-snug);
    color: var(--color-copy-inverse);
  }

  .inner :global(.btn) { margin-top: var(--sp-lg); }

  @media (max-width: 900px) {
    .masterclass {
      height: auto;
      min-height: var(--size-masterclass-height);
      padding-block: var(--sp-footer);
    }

    .background {
      left: 0;
      width: 100%;
      height: 100%;
    }

    .background :global(img) {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 70% center;
    }

    .background::after {
      background: linear-gradient(90deg, var(--color-overlay-base), color-mix(in srgb, var(--color-overlay-base) 40%, transparent));
    }

    .blur { display: none; }

    h2,
    .inner p { width: 100%; }
  }
</style>
