---
import { Image } from "astro:assets";
import poolBg from "../../assets/testimonial-bg-figma.png";
import emma from "../../assets/testimonial-01-figma.png";
import noah from "../../assets/testimonial-02-figma.png";

/**
 * The design's dial reads "/ 04", but only two cards carry copy — the third and
 * fourth sit outside the frame. The counter below is driven by the real slide
 * count rather than a hardcoded 04, so it stays truthful until the remaining
 * testimonials arrive.
 *
 * TODO(figma): Noah's quote is reconstructed from a card clipped by the frame
 * edge. The visible line breaks constrain the wording tightly, but it should be
 * verified against the Figma file before launch.
 */
const testimonials = [
  {
    quote:
      "I used to arrive at every meet wondering which version of me would show up. Now I have a routine that helps me settle in, focus on my race, and trust the work I've already done.",
    name: "Emma Collins",
    role: "High School Swimmer",
    img: emma,
    alt: "Emma Collins beside a pool",
  },
  {
    quote:
      "One disappointing swim used to affect the rest of my meet. Learning how to reset between races changed everything. I review what happened without carrying it onto the next race.",
    name: "Noah Bennett",
    role: "College Swimmer",
    img: noah,
    alt: "Noah Bennett beside a pool",
  },
];

const total = String(testimonials.length).padStart(2, "0");
---

<section class="testimonials band-light">
  <Image src={poolBg} alt="" class="bg-media" widths={[1200, 1920]} sizes="100vw" />
  <div class="veil" aria-hidden="true"></div>

  <div class="inner" data-testimonials data-index="0">
    <div class="lede">
      <h2>Confidence That Holds Under Pressure</h2>
      <p>
        What swimmers say about the changes they notice&mdash;in training, at
        meets, and between races.
      </p>

      <div class="dial">
        <img src="/testimonial-ring-1.svg" alt="" class="ring ring--one" aria-hidden="true" />
        <img src="/testimonial-ring-2.svg" alt="" class="ring ring--two" aria-hidden="true" />

        <button type="button" class="arrow" data-dir="-1" aria-label="Previous testimonial">
          <img src="/testimonial-arrow-left.svg" alt="" aria-hidden="true" />
        </button>

        <p class="count" aria-live="polite">
          <span class="current">01</span>
          <span class="total">/ {total}</span>
        </p>

        <button type="button" class="arrow" data-dir="1" aria-label="Next testimonial">
          <img src="/testimonial-arrow-right.svg" alt="" aria-hidden="true" />
        </button>
      </div>
    </div>

    <div class="viewport" tabindex="0" aria-label="Testimonials">
      <ul class="track">
        {testimonials.map(({ quote, name, role, img, alt }) => (
          <li class="card">
            <div class="card-copy">
              <div class="quote">
                <span class="marks" aria-hidden="true">
                  <img src="/testimonial-quote-1.svg" alt="" />
                  <img src="/testimonial-quote-2.svg" alt="" />
                </span>

                <blockquote>{quote}</blockquote>
              </div>

              <div class="author">
                <p class="name">{name}</p>
                <p class="role">{role}</p>
              </div>
            </div>

            <Image src={img} alt={alt} class="portrait" widths={[288, 576]} sizes="(max-width: 900px) calc(100vw - 80px), 288px" />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-testimonials]");
  const viewport = root?.querySelector<HTMLElement>(".viewport");
  const track = root?.querySelector<HTMLElement>(".track");
  const current = root?.querySelector<HTMLElement>(".count .current");
  const cards = track ? Array.from(track.querySelectorAll<HTMLElement>(".card")) : [];
  let index = 0;

  const paint = () => {
    if (!root || !track || cards.length === 0) return;
    const offset = cards[index].offsetLeft - cards[0].offsetLeft;
    track.style.transform = `translate3d(${-offset}px, -50%, 0)`;
    root.dataset.index = String(index);
    if (current) current.textContent = String(index + 1).padStart(2, "0");
    cards.forEach((card, cardIndex) => card.setAttribute("aria-hidden", String(cardIndex !== index)));
  };

  const move = (direction: number) => {
    if (cards.length === 0) return;
    index = (index + direction + cards.length) % cards.length;
    paint();
  };

  root?.querySelectorAll<HTMLButtonElement>(".arrow").forEach((btn) => {
    btn.addEventListener("click", () => {
      move(Number(btn.dataset.dir));
    });
  });

  viewport?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      move(event.key === "ArrowLeft" ? -1 : 1);
    }
  });

  window.addEventListener("resize", paint, { passive: true });
  paint();
</script>

<style>
  .testimonials {
    position: relative;
    isolation: isolate;
    height: var(--size-testimonials-height);
    overflow: hidden;
    padding-block: var(--sp-testimonials-top) var(--sp-content);
    background: var(--color-surface-light);
  }

  .testimonials :global(.bg-media) {
    object-position: center;
    opacity: 0.3;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, var(--color-surface-light), transparent);
  }

  .inner {
    --testimonial-left: calc((100vw - var(--content-width)) / 2 + var(--sp-testimonial-inset));
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: calc(100% - var(--testimonial-left));
    height: var(--size-testimonial-stage-height);
    margin-left: var(--testimonial-left);
  }

  .lede {
    flex: none;
    width: var(--size-testimonial-lede);
  }

  .lede > p {
    margin-top: var(--sp-med);
    font-size: var(--type-subtitle);
    line-height: var(--lh-loose);
    color: var(--color-ink-default);
  }

  .dial {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-quote);
    width: var(--size-testimonial-dial);
    height: var(--size-testimonial-dial);
    margin-top: var(--sp-testimonial);
  }

  .ring {
    position: absolute;
    top: calc(var(--sp-micro) * -1);
    left: calc(var(--sp-xxs) * -1);
    width: var(--size-testimonial-ring);
    height: var(--size-testimonial-ring);
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .ring--two { opacity: 0; }
  .inner[data-index="1"] .ring--one { opacity: 0; }
  .inner[data-index="1"] .ring--two { opacity: 1; }

  .arrow {
    position: relative;
    z-index: 1;
    width: var(--size-testimonial-arrow);
    height: var(--size-testimonial-arrow);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .arrow img { width: 100%; height: 100%; }
  .arrow:first-of-type img { transform: scaleX(-1); }

  .count {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-xs);
    width: var(--size-testimonial-counter);
    text-align: center;
    line-height: var(--lh-tight);
  }

  .current {
    font-size: var(--type-counter-current);
    font-weight: 500;
    font-style: italic;
    color: var(--color-ink-default);
  }

  .total {
    font-size: var(--type-counter-total);
    font-style: italic;
    color: var(--color-counter-muted);
  }

  .viewport {
    position: relative;
    flex: none;
    width: var(--size-testimonial-viewport);
    height: var(--size-testimonial-stage-height);
    overflow: hidden;
  }

  .track {
    position: absolute;
    top: 50%;
    left: var(--sp-med);
    display: flex;
    align-items: center;
    gap: var(--sp-carousel);
    list-style: none;
    transform: translate3d(0, -50%, 0);
    transition: transform var(--duration-base) var(--ease-out);
    will-change: transform;
  }

  .card {
    flex: 0 0 var(--size-testimonial-card-width);
    display: flex;
    align-items: center;
    gap: var(--sp-testimonial-card-inner);
    width: var(--size-testimonial-card-width);
    height: var(--size-testimonial-card-height);
    padding: var(--sp-lg);
    background: var(--color-surface-raised);
    border-radius: var(--radius-feature);
    box-shadow: var(--shadow-testimonial);
  }

  .card-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-testimonial);
    width: var(--size-testimonial-copy);
    height: var(--size-testimonial-portrait-height);
  }

  .quote {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-med);
  }

  .marks {
    display: flex;
    gap: var(--sp-quote);
  }

  .marks img {
    width: var(--size-testimonial-quote-width);
    height: var(--size-testimonial-quote-height);
  }

  blockquote {
    margin: 0;
    font-size: var(--type-subtitle);
    line-height: var(--lh-loose);
    color: var(--color-ink-default);
  }

  .author {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
  }

  .name {
    font-weight: 700;
    font-size: var(--type-subtitle);
    line-height: var(--lh-tight);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .role {
    font-size: var(--type-subtitle);
    line-height: var(--lh-loose);
    color: var(--color-text-body);
  }

  .card :global(.portrait) {
    flex: none;
    width: var(--size-testimonial-portrait-width);
    height: var(--size-testimonial-portrait-height);
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  @media (max-width: 900px) {
    .testimonials {
      height: auto;
      padding-block: var(--sp-footer);
    }

    .inner {
      display: flex;
      flex-direction: column;
      gap: var(--sp-lg);
      width: min(calc(100% - var(--sp-lg)), var(--content-width));
      height: auto;
      margin-inline: auto;
    }

    .lede { width: 100%; }
    .dial { margin-inline: auto; }

    .viewport {
      width: 100%;
      height: var(--size-testimonial-mobile-viewport);
    }

    .track {
      left: 0;
      gap: var(--sp-sm);
      width: 100%;
    }

    .card {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-sm);
      width: 100%;
      height: var(--size-testimonial-mobile-card);
      padding: var(--sp-sm);
    }

    .card-copy {
      order: 2;
      width: 100%;
      height: auto;
      gap: var(--sp-sm);
    }

    .quote { gap: var(--sp-sm); }

    blockquote { font-size: var(--type-body-18); }

    .card :global(.portrait) {
      order: 1;
      width: 100%;
      height: var(--size-testimonial-mobile-portrait);
    }
  }
</style>
