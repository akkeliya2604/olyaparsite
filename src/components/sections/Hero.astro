---
import { Image } from "astro:assets";
import Header from "../Header.astro";
import Button from "../Button.astro";
import heroBg from "../../assets/hero-background-figma.png";
---

<section class="hero band-dark" id="top">
  <Image
    src={heroBg}
    alt=""
    class="bg-media"
    widths={[900, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="scrim" aria-hidden="true"></div>

  <Header />

  <div class="wrap content">
    <h1>
      Swim the <em class="accent">race</em><br />
      <em class="you">you</em> <em class="accent">trained for</em>
    </h1>

    <p class="subtitle">
      Race Ready mental performance training helps competitive swimmers build
      the confidence, composure, and focus to perform when the clock starts.
    </p>

    <p class="eyebrow">For competitive swimmers, from age-group through college.</p>

    <div class="actions">
      <Button href="#masterclass">Watch the Free Masterclass</Button>
      <Button href="#course" variant="outline">Explore the Race Ready Method</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    height: var(--size-hero-height);
    overflow: hidden;
  }

  .hero :global(.bg-media) {
    inset: 0 auto auto 50%;
    width: var(--size-hero-bg-width);
    height: var(--size-hero-height);
    max-width: none;
    transform: translateX(-50%);
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(var(--color-hero-overlay), var(--color-hero-overlay)),
      linear-gradient(0deg, var(--color-overlay-base), transparent) left bottom / 100% var(--size-hero-bottom-gradient-height) no-repeat,
      linear-gradient(90deg, var(--color-overlay-base), color-mix(in srgb, var(--color-overlay-base) 80%, transparent) 13.852%, transparent)
        var(--size-hero-left-gradient-offset) 0 / var(--size-hero-left-gradient-width) var(--size-hero-left-gradient-height) no-repeat;
  }

  .content {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--sp-footer) + var(--sp-sm) + var(--size-logo-height) + var(--sp-hero-nav-gap));
  }

  h1 {
    text-transform: uppercase;
    width: var(--size-hero-title);
    max-width: 100%;
  }

  .you { color: var(--color-ink-inverse); font-style: italic; }

  .subtitle {
    width: var(--size-hero-subtitle);
    max-width: 100%;
    margin-top: var(--sp-hero-copy);
    font-size: var(--type-subtitle);
    line-height: var(--lh-loose);
    color: var(--color-ink-inverse);
  }

  .eyebrow {
    width: var(--size-hero-actions);
    max-width: 100%;
    margin-top: var(--sp-hero-stage);
    font-size: var(--type-body-16);
    line-height: var(--lh-snug);
    color: var(--color-ink-inverse);
  }

  .actions {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--sp-med);
    width: var(--size-hero-actions);
    max-width: 100%;
    margin-top: var(--sp-hero-copy);
  }

  @media (max-width: 900px) {
    .hero {
      height: auto;
      min-height: var(--size-hero-height);
    }

    .hero :global(.bg-media) {
      left: 50%;
      width: 100%;
      height: 100%;
      object-position: 60% center;
    }

    .scrim {
      background:
        linear-gradient(var(--color-hero-overlay), var(--color-hero-overlay)),
        linear-gradient(0deg, var(--color-overlay-base), transparent) left bottom / 100% var(--size-hero-bottom-gradient-height) no-repeat;
    }

    .content {
      padding-block: calc(var(--sp-content) + var(--sp-footer)) var(--sp-footer);
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .actions :global(.btn) {
      width: 100%;
      padding-inline: var(--sp-sm);
      font-size: var(--type-body-16);
    }
  }
</style>
