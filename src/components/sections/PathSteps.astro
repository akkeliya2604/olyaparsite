---
import { Image } from "astro:assets";
import understand from "../../assets/path-understand-figma.jpg";
import train from "../../assets/path-train-figma.jpg";
import personalize from "../../assets/path-personalize-figma.jpg";

const steps = [
  {
    n: "1",
    title: "Understand",
    body: "Watch the free masterclass and identify where pressure, doubt, or distraction is affecting your performance.",
    img: understand,
  },
  {
    n: "2",
    title: "Train",
    body: "Build your foundation with the Race Ready Method and practice the eight mental skills week by week.",
    img: train,
  },
  {
    n: "3",
    title: "Personalize",
    body: "Go deeper through a Race Strategy Intensive, ongoing coaching, or a team program with Maya.",
    img: personalize,
  },
];
---

<section class="band-light path">
  <div class="wrap grid">
    <div class="heading-sticky">
      <h2>Your <em class="accent caps">Race-Ready path</em></h2>
    </div>

    <img src="/path-line.svg" alt="" class="path-line" aria-hidden="true" />

    <ol class="steps">
      {steps.map(({ n, title, body, img }) => (
        <li class="step">
          <div class="thumb">
            <Image src={img} alt="" widths={[300, 600]} sizes="(max-width: 900px) 100vw, 300px" />
            <span class="numeral" aria-hidden="true">{n}</span>
          </div>

          <h3>{title}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .path { height: var(--size-path-height); }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    height: 100%;
  }

  .heading-sticky {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    height: 100%;
  }

  .heading-sticky h2 {
    position: sticky;
    top: 0;
    padding-top: var(--sp-content);
  }

  .path-line {
    position: absolute;
    top: 0;
    left: calc(50% - var(--pos-path-line-offset));
    width: var(--size-path-line-width);
    height: var(--size-path-line-height);
    max-width: none;
  }

  .steps {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sp-path-step-gap);
    width: var(--size-path-column);
    margin-top: var(--pos-path-steps-top);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-paragraph);
    width: 100%;
  }

  .step:nth-child(1) { width: var(--size-path-step-one); }
  .step:nth-child(2) { width: var(--size-path-step-two); }

  .thumb {
    position: relative;
    height: var(--size-path-media-height);
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--color-surface-dark);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-image-dim);
  }

  .step:last-child .thumb::after { background: var(--color-image-dim-soft); }

  .numeral {
    position: absolute;
    left: var(--sp-lg);
    top: 50%;
    z-index: 1;
    transform: translateY(-50%);
    font-size: var(--type-step-number);
    font-weight: 700;
    line-height: var(--lh-tight);
    color: transparent;
    -webkit-text-stroke: var(--sp-hairline) var(--color-ink-inverse);
  }

  .step h3 {
    font-size: var(--type-h4);
    text-transform: uppercase;
  }

  .step p {
    font-size: var(--type-body-18);
    line-height: var(--lh-snug);
    color: var(--color-text-strong);
  }

  @media (max-width: 900px) {
    .path {
      height: auto;
      padding-block: var(--sp-footer);
    }

    .grid {
      grid-template-columns: 1fr;
      height: auto;
    }

    .heading-sticky {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      height: auto;
    }

    .heading-sticky h2 { position: static; padding-top: 0; }
    .path-line { display: none; }

    .steps {
      grid-column: 1;
      grid-row: 2;
      width: 100%;
      margin-top: var(--sp-lg);
    }

    .step,
    .step:nth-child(1),
    .step:nth-child(2) { width: 100%; }
  }
</style>
