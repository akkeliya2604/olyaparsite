---
import { Image } from "astro:assets";
import MotionMark from "../MotionMark.astro";
import oldWay from "../../assets/problem-old-way.png";
import raceReady from "../../assets/problem-race-ready.jpg";
---

<section class="band-light problem" id="about">
  <div class="wrap grid">
    <div class="copy">
      <div class="heading">
        <MotionMark />
        <h2>Most swimmers train everything but the moment that decides the race</h2>
      </div>
      <div class="body">
        <p>You know your pace. You have done the sets. Your body is ready.</p>
        <p>
          But when the meet gets loud, the pressure builds, or the first split is
          not what you expected, your mind can pull you away from the race you
          trained to swim.
        </p>
        <p>
          Physical preparation gets you to the block. Mental preparation helps you
          trust your training when the moment arrives.
        </p>
      </div>
    </div>

    <div class="cards">
      <article class="card card--old">
        <Image src={oldWay} alt="" class="bg-media" widths={[420, 700]} sizes="(max-width: 900px) 100vw, 420px" />
        <div class="card-body">
          <h3>The old way:</h3>
          <p>Hope confidence shows up on race day.</p>
        </div>
      </article>

      <article class="card card--accent">
        <Image src={raceReady} alt="" class="bg-media" widths={[420, 700]} sizes="(max-width: 900px) 100vw, 420px" />
        <div class="card-body">
          <h3>The Race Ready way:</h3>
          <p>Train confidence, focus, and composure like any other performance skill.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .problem {
    height: var(--size-problem-height);
    padding-top: var(--sp-problem-top);
  }

  .grid {
    display: grid;
    grid-template-columns: var(--size-problem-cards) var(--size-problem-copy);
    justify-content: space-between;
    align-items: center;
  }

  /* Visual order is cards-then-copy; source order is copy-then-cards so the
     heading outline and the screen-reader reading order both stay correct. */
  .cards {
    order: -1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-problem-card);
  }

  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--sp-problem-card-inner);
    width: var(--size-problem-cards);
    height: var(--size-problem-card-height);
    padding: var(--sp-problem-card);
    border: var(--sp-hairline) solid var(--color-border-subtle);
    border-radius: 0 var(--radius-feature) 0 0;
    overflow: hidden;
    background: var(--color-surface-light);
    color: var(--color-ink-default);
  }

  .card :global(.bg-media) {
    opacity: 0.2;
    transition: opacity var(--duration-hover) var(--ease-linear);
  }

  .card::before,
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: color;
    pointer-events: none;
    transition: opacity var(--duration-hover) var(--ease-linear);
  }

  .card::before {
    background: linear-gradient(90deg, var(--color-overlay-base), transparent);
  }

  .card::after {
    background: var(--color-surface-dark);
    opacity: 0;
  }

  .card-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--sp-problem-card-inner);
  }

  .card h3 {
    text-transform: uppercase;
    font-size: var(--type-card-title);
  }

  .card p {
    font-size: var(--type-body-16);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
    transition: color var(--duration-hover) var(--ease-linear);
  }

  .card h3 { transition: color var(--duration-hover) var(--ease-linear); }

  .card--old :global(.bg-media) {
    inset: -68.66% auto auto 0.08%;
    width: var(--size-problem-old-image-width);
    height: var(--size-problem-old-image-height);
    max-width: none;
  }

  .card--accent {
    border-width: 0 0 0 var(--sp-micro);
    border-color: var(--color-accent);
    border-radius: 0 0 var(--radius-feature) 0;
  }
  .card--accent h3 { color: var(--color-accent); }

  .card--old:hover :global(.bg-media) { opacity: 1; }
  .card--old:hover::before { opacity: 0; }
  .card--old:hover::after { opacity: 1; }
  .card--old:hover h3 { color: var(--color-ink-inverse); }
  .card--old:hover p { color: var(--color-copy-inverse); }

  .card--accent:hover :global(.bg-media) { opacity: 1; }
  .card--accent::after {
    background: linear-gradient(0deg, color-mix(in srgb, var(--color-overlay-base) 80%, transparent), transparent);
    mix-blend-mode: normal;
  }
  .card--accent:hover::before { opacity: 0; }
  .card--accent:hover::after { opacity: 1; }
  .card--accent:hover h3,
  .card--accent:hover p { color: var(--color-ink-inverse); }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-paragraph);
  }

  .body { display: flex; flex-direction: column; gap: var(--sp-paragraph); }

  .copy p {
    font-size: var(--type-body-18);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .body p + p { margin-top: var(--sp-hairline); }

  @media (max-width: 900px) {
    .problem {
      height: auto;
      padding-block: var(--sp-footer);
    }

    .grid {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }

    .cards,
    .card { width: 100%; }
  }
</style>
