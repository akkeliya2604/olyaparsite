---
import Button from "../Button.astro";

/**
 * TODO(figma): the three tiles are empty white rectangles in the design — no
 * images were placed. Rendered as empty framed slots rather than invented
 * content; drop real posts (or an embed) in when available.
 *
 * Two wording fixes applied against the design: "perfomance" -> "performance",
 * and "Follow in Instagram" -> "Follow on Instagram". Both are plain language
 * errors rather than design decisions. Worth correcting in Figma too.
 */
const tiles = [
  { ratio: "3 / 4", label: "Instagram post placeholder 1" },
  { ratio: "3 / 5", label: "Instagram post placeholder 2" },
  { ratio: "3 / 4", label: "Instagram post placeholder 3" },
];
---

<section class="band-light section">
  <div class="wrap">
    <h2>Follow the work</h2>

    <p class="lede">
      Mental performance tools for training days, race days, and everything in
      between.
    </p>

    <div class="actions">
      <a href="#contact" class="glyph" aria-label="Instagram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.8" />
          <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8" />
          <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" />
        </svg>
      </a>

      <Button href="#contact" size="sm">Follow on Instagram</Button>
    </div>

    <ul class="tiles">
      {tiles.map(({ ratio, label }) => (
        <li class="tile" style={`aspect-ratio:${ratio}`} aria-label={label}></li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 { text-align: center; }

  .lede {
    margin-top: var(--sp-paragraph);
    text-align: center;
    font-size: var(--type-body-16);
    color: var(--color-text-body);
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: var(--sp-sm);
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--white);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: var(--sp-sm);
    max-width: 780px;
    margin: var(--sp-lg) auto 0;
    list-style: none;
  }

  .tile {
    background: var(--white);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 700px) {
    .tiles { grid-template-columns: 1fr; }
  }
</style>
