---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import postOne from "../../assets/instagram-post-01.jpg";
import postTwo from "../../assets/instagram-post-02.jpg";
import storyOne from "../../assets/instagram-story-01.jpg";
---

<section class="band-light section">
  <div class="wrap layout">
    <div class="first-column">
      <div class="intro">
        <h2>Follow the work</h2>

        <p class="lede">
          Mental performance tools for training days, race days, and everything in
          between.
        </p>

        <div class="actions">
          <a href="#contact" class="glyph" aria-label="Instagram">
            <img src="/instagram-icon.svg" alt="" />
          </a>

          <Button href="#contact" size="sm">Follow on Instagram</Button>
        </div>
      </div>

      <figure class="tile tile--first">
        <Image src={postOne} alt="" widths={[412, 824]} sizes="(max-width: 900px) 100vw, 412px" />
      </figure>
    </div>

    <figure class="tile tile--tall">
      <Image src={postTwo} alt="" widths={[412, 824]} sizes="(max-width: 900px) 100vw, 412px" />
    </figure>

    <figure class="tile tile--tall">
      <Image src={storyOne} alt="" widths={[412, 824]} sizes="(max-width: 900px) 100vw, 412px" />
    </figure>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    gap: var(--sp-paragraph);
  }

  .first-column {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 733px;
  }

  .lede {
    margin-top: var(--sp-sm);
    font-size: var(--type-body-18);
    color: var(--color-text);
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--sp-paragraph);
    margin-top: var(--sp-sm);
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
  }

  .glyph img { width: 100%; height: 100%; }

  .tile { margin: 0; overflow: hidden; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tile--first { height: 515px; }
  .tile--tall { height: 733px; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .first-column { min-height: 0; gap: var(--sp-lg); }
    .tile--first,
    .tile--tall { height: auto; aspect-ratio: 4 / 5; }
  }
</style>
