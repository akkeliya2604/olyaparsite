---
import { Image } from "astro:assets";
import swimmer from "../../assets/audience-swimmer-figma.png";

const groups = [
  {
    label: "Primary:",
    body: "Competitive age-group and high-school swimmers working toward qualifying times, championship meets, and national-level goals.",
  },
  {
    label: "Also:",
    body: "Younger competitive swimmers building confidence, focus, and healthy performance habits early.",
  },
  {
    label: "And:",
    body: "College swimmers who want to perform more consistently under pressure and take greater ownership of their preparation.",
  },
];
---

<section class="band-light audience">
  <div class="wrap grid">
    <div class="copy">
      <h2>Built for competitive swimmers</h2>

      <dl class="groups">
        {groups.map(({ label, body }) => (
          <div class="group">
            <dt>{label}</dt>
            <dd>{body}</dd>
          </div>
        ))}
      </dl>

      <aside class="parents">
        <p class="parents-label">Parents:</p>
        <p>
          Race Ready gives your swimmer practical tools for handling pressure
          and gives you a clearer way to support long-term development without
          making every result feel bigger than it needs to be.
        </p>
      </aside>
    </div>

    <figure class="media">
      <img src="/audience-wordmark.svg" alt="" class="watermark" aria-hidden="true" />
      <Image src={swimmer} alt="A swimmer mid-stroke underwater" widths={[520, 900]} sizes="(max-width: 900px) 100vw, 520px" />
    </figure>
  </div>
</section>

<style>
  .audience {
    position: relative;
    height: var(--size-audience-height);
    overflow: hidden;
  }

  .grid {
    position: relative;
    height: 100%;
  }

  .copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--sp-audience-block);
    width: var(--size-audience-copy);
    padding-top: var(--sp-content);
  }

  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    margin: 0;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    width: var(--size-audience-copy);
    padding-bottom: var(--sp-xxs);
    border-left: 0 solid var(--color-brand-detail);
    transition:
      border-left-width var(--duration-hover) var(--ease-linear),
      padding-left var(--duration-hover) var(--ease-linear);
  }

  .group:hover {
    padding-left: var(--sp-sm);
    border-left-width: var(--sp-micro);
  }

  .group:nth-child(2) { width: var(--content-width); }

  dt {
    font-weight: 700;
    font-size: var(--type-subtitle);
    line-height: var(--lh-loose);
    color: var(--color-brand-detail);
  }

  dd {
    margin: 0;
    font-size: var(--type-body-18);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .parents {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-paragraph);
    width: var(--size-audience-copy);
    height: var(--size-audience-parent-height);
    padding: var(--sp-sm) var(--sp-lg);
    background: var(--color-surface-tint);
    border: var(--sp-hairline) solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .parents:hover { border-color: var(--color-border-emphasis); }

  .parents-label {
    flex: none;
    font-family: var(--font-alt);
    font-weight: 700;
    font-size: var(--type-alt-sub);
    line-height: var(--lh-loose);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .parents p:last-child {
    font-size: var(--type-body-18);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .media {
    position: absolute;
    top: 0;
    left: var(--pos-audience-media-left);
    z-index: 1;
    width: var(--size-audience-media-width);
    height: var(--size-audience-media-height);
    margin: 0;
    overflow: hidden;
  }

  .watermark {
    position: absolute;
    top: var(--pos-audience-wordmark-top);
    left: var(--pos-audience-wordmark-left);
    width: var(--size-audience-wordmark-width);
    height: var(--size-audience-wordmark-height);
    max-width: none;
    pointer-events: none;
  }

  .media :global(img) {
    position: absolute;
    top: -4.83%;
    left: 1.48%;
    width: var(--size-audience-image-width);
    height: var(--size-audience-image-height);
    max-width: none;
  }

  .media :global(.watermark) {
    top: var(--pos-audience-wordmark-top);
    left: var(--pos-audience-wordmark-left);
    width: var(--size-audience-wordmark-width);
    height: var(--size-audience-wordmark-height);
  }

  @media (max-width: 900px) {
    .audience {
      height: auto;
      padding-block: var(--sp-footer);
    }

    .grid { height: auto; }

    .copy {
      width: 100%;
      padding-top: 0;
      gap: var(--sp-lg);
    }

    .groups,
    .group,
    .parents { width: 100%; }

    .parents {
      height: auto;
      border-radius: var(--radius-faq);
      padding-inline: var(--sp-sm);
    }

    .media {
      position: relative;
      left: auto;
      width: calc(100% + var(--sp-lg));
      height: auto;
      aspect-ratio: 3 / 2;
      margin: var(--sp-lg) calc(var(--sp-sm) * -1) 0;
    }

    .watermark,
    .media :global(.watermark) {
      top: var(--sp-sm);
      left: var(--sp-sm);
      width: calc(100% - var(--sp-lg));
      height: auto;
    }
  }
</style>
