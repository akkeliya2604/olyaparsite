---
/**
 * TODO(figma): every accordion is collapsed in the design, so no answer copy
 * exists in the file. Questions are verbatim; answers are placeholders and
 * must be written before launch.
 *
 * The button/region pattern preserves keyboard and screen-reader operation
 * while allowing the exact 300ms prototype transition.
 */
const faqs = [
  ["Is this only for swimmers who", "are struggling?"],
  ["How much time does the program", "usually take?"],
  ["Will this help with pre-race nerves?"],
  ["Is this only for elite swimmers?"],
  ["How is this different from", "motivational coaching?"],
  ["What if my swimmer does not", "like talking about mindset?"],
];

---

<section class="band-light section faq" data-faq>
  <div class="wrap">
    <h2><em class="accent">Questions</em> swimmers and parents <em class="accent">ask</em></h2>

    <div class="grid">
      {faqs.map((lines, index) => (
        <article class="item">
          <button
            type="button"
            class="question"
            id={`faq-question-${index}`}
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
          >
            <span>
              {lines.map((line, lineIndex) => (
                <>{lineIndex > 0 && <><br aria-hidden="true" />{" "}</>}{line}</>
              ))}
            </span>
            <span class="sign" aria-hidden="true">
              <img src="/faq-closed.svg" alt="" class="sign-closed" />
              <img src="/faq-open.svg" alt="" class="sign-open" />
            </span>
          </button>
          <div
            class="answer"
            id={`faq-answer-${index}`}
            role="region"
            aria-labelledby={`faq-question-${index}`}
            aria-hidden="true"
          >
            <div><p>Answer to be supplied.</p></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq] .item").forEach((item) => {
    const button = item.querySelector<HTMLButtonElement>(".question");
    const answer = item.querySelector<HTMLElement>(".answer");

    button?.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!open));
      answer?.setAttribute("aria-hidden", String(open));
      item.classList.toggle("is-open", !open);
    });
  });
</script>

<style>
  .faq { min-height: var(--size-faq-height); }

  h2 { text-align: center; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--sp-med);
    row-gap: var(--sp-xs);
    margin-top: var(--sp-med);
  }

  .item {
    align-self: start;
    width: 100%;
    padding: var(--sp-card);
    background: var(--color-surface-raised);
    border: var(--sp-hairline) solid var(--color-border-subtle);
    border-radius: var(--radius-faq);
    transition: background-color var(--duration-base) var(--ease-in-out);
  }

  .question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm);
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-strong);
    font-family: inherit;
    font-weight: 700;
    font-size: var(--type-h4);
    line-height: var(--lh-tight);
    text-align: left;
    cursor: pointer;
  }

  .question > span:first-child {
    width: var(--size-faq-question);
    max-width: calc(100% - var(--size-faq-icon) - var(--sp-sm));
  }

  .sign {
    position: relative;
    flex: none;
    width: var(--size-faq-icon);
    height: var(--size-faq-icon);
  }

  .sign img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity var(--duration-base) var(--ease-in-out);
  }

  .sign-open { opacity: 0; }

  .answer {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--duration-base) var(--ease-in-out),
      margin-top var(--duration-base) var(--ease-in-out),
      opacity var(--duration-base) var(--ease-in-out),
      visibility 0s linear var(--duration-base);
  }

  .answer > div { overflow: hidden; }

  .answer p {
    width: var(--size-faq-answer);
    max-width: 100%;
    font-size: var(--type-body-16);
    line-height: var(--lh-snug);
    color: var(--color-text-strong);
  }

  .item.is-open { background: var(--color-control-tint); }
  .item.is-open .sign-closed { opacity: 0; }
  .item.is-open .sign-open { opacity: 1; }

  .item.is-open .answer {
    grid-template-rows: 1fr;
    margin-top: var(--sp-card);
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows var(--duration-base) var(--ease-in-out),
      margin-top var(--duration-base) var(--ease-in-out),
      opacity var(--duration-base) var(--ease-in-out),
      visibility 0s linear;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
