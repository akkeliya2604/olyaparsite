---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import bg from "../../assets/principle-visualization.png";
---

<section class="final band-dark">
  <Image src={bg} alt="" class="bg-media" widths={[1200, 1920]} sizes="100vw" loading="lazy" />
  <div class="veil" aria-hidden="true"></div>

  <div class="wrap inner">
    <h2>
      Start training<br />
      the mental game
    </h2>

    <Button href="#masterclass">Watch the Free Masterclass</Button>
  </div>

  <!-- Thin accent strip separating the band from the footer plate. -->
  <div class="rule" aria-hidden="true"></div>
</section>

<style>
  .final {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--sp-content);
    text-align: center;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.62);
  }

  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-med);
  }

  h2 {
    text-transform: uppercase;
    font-size: clamp(2rem, 1rem + 3.6vw, 3.5rem);
    line-height: 1.08;
  }

  .rule {
    position: absolute;
    left: 25%;
    right: 25%;
    bottom: 0;
    z-index: 2;
    height: 6px;
    border-radius: var(--radius-pill) var(--radius-pill) 0 0;
    background: #1C5C86;
  }
</style>
