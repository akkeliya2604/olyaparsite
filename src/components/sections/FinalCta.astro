---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import bg from "../../assets/final-cta-bg-figma.png";
---

<section class="final band-dark">
  <div class="background" aria-hidden="true">
    <Image src={bg} alt="" widths={[1200, 1920]} sizes="100vw" loading="lazy" />
  </div>

  <div class="wrap inner">
    <h2>
      Start training<br />
      the mental game
    </h2>

    <Button href="#masterclass" tone="accent">Watch the Free Masterclass</Button>
  </div>

</section>

<style>
  .final {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: var(--size-final-height);
    display: grid;
    place-items: center;
    padding-block: var(--sp-final);
    text-align: center;
  }

  .background {
    position: absolute;
    top: var(--pos-final-bg-top);
    left: var(--pos-final-bg-left);
    width: var(--size-final-bg-width);
    height: var(--size-final-bg-height);
    opacity: 0.3;
  }

  .background :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .background::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(270deg, transparent 82.034%, var(--color-overlay-base)),
      linear-gradient(270deg, var(--color-overlay-base), transparent 17.966%);
  }

  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-lg);
    width: var(--size-final-copy);
  }

  h2 {
    text-transform: uppercase;
    font-size: var(--type-h1);
    line-height: var(--lh-snug);
  }

  @media (max-width: 900px) {
    .final {
      height: auto;
      min-height: var(--size-final-height);
      padding-block: var(--sp-footer);
    }

    .background {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    .background :global(img) { object-fit: cover; }
    .inner { width: 100%; }
  }
</style>
