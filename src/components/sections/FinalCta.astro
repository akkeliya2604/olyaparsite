---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import bg from "../../assets/final-cta-bg-figma.png";
---

<section class="final band-dark">
  <Image src={bg} alt="" class="bg-media" widths={[1200, 1920]} sizes="100vw" loading="lazy" />
  <div class="veil" aria-hidden="true"></div>

  <div class="wrap inner">
    <h2>
      Start training<br />
      the mental game
    </h2>

    <Button href="#masterclass">Watch the Free Masterclass</Button>
  </div>

</section>

<style>
  .final {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 532px;
    display: grid;
    place-items: center;
    padding-block: var(--sp-content);
    text-align: center;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--black) 62%, transparent);
  }

  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-med);
  }

  h2 {
    text-transform: uppercase;
    font-size: clamp(2rem, 1rem + 3.6vw, 3.5rem);
    line-height: 1.08;
  }
</style>
