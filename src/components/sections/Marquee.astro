---
const items = [
  "Mental performance for competitive swimmers",
  "Race-day routines that work under pressure",
  "Built for age-group through college athletes",
  "Support for swimmers, parents, and teams",
  "Created by Maya Reynolds",
];

// Duplicated once so the translation can loop seamlessly. The copy is
// aria-hidden so the list is announced a single time.
---

<div class="marquee band-dark">
  <div class="track">
    <ul class="row">
      {items.map((t) => (
        <li>
          <span>{t}</span>
          <img src="/marquee-mark.svg" alt="" aria-hidden="true" />
        </li>
      ))}
    </ul>
    <ul class="row" aria-hidden="true">
      {items.map((t) => (
        <li>
          <span>{t}</span>
          <img src="/marquee-mark.svg" alt="" aria-hidden="true" />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .marquee {
    display: flex;
    align-items: center;
    height: var(--size-marquee-height);
    overflow: hidden;
    background: var(--color-accent);
  }

  .track {
    display: flex;
    gap: var(--sp-marquee);
    width: max-content;
    animation: scroll var(--duration-marquee) var(--ease-linear) infinite;
  }

  .row {
    display: flex;
    align-items: center;
    list-style: none;
  }

  .row li {
    display: flex;
    align-items: center;
    gap: var(--sp-marquee);
    margin-right: var(--sp-marquee);
    font-size: var(--type-body-16);
    line-height: var(--lh-snug);
    font-weight: 700;
    letter-spacing: var(--tracking-marquee);
    white-space: nowrap;
    color: var(--color-ink-inverse);
  }

  .row li img {
    flex: none;
    width: var(--size-logo-detail-width);
    height: var(--size-logo-detail-height);
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - var(--sp-marquee-half-gap))); }
  }

  /* A continuously moving strip is a vestibular trigger; stop it outright. */
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .marquee { overflow-x: auto; }
  }
</style>
