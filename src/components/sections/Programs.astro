---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import MotionMark from "../MotionMark.astro";
import background from "../../assets/program-background-figma.png";

const programs = [
  {
    label: "Free masterclass",
    title: "The Race-Ready Mind",
    body: "Learn why physical preparation alone does not guarantee a strong race—and how swimmers can build confidence, composure, focus, and resilience before the next important meet.",
    cta: "Watch Free",
    href: "#masterclass",
    featured: false,
  },
  {
    label: "Main program",
    title: "The Race Ready Method",
    body: "An eight-week self-paced program that helps swimmers train the mental side of performance through short lessons, practical exercises, visualization, and race-day routines.",
    cta: "Explore the Method",
    href: "#course",
    featured: true,
  },
  {
    label: "Individual session",
    title: "Race Strategy Intensive",
    body: "A focused 90-minute one-to-one session with Maya. Identify what is getting in the way of your performance and leave with a personalized mental race plan.",
    cta: "Book an Intensive",
    href: "#contact",
    featured: false,
  },
];
---

<section class="programs band-dark">
  <div class="backgrounds" aria-hidden="true">
    <Image src={background} alt="" widths={[1200, 1920]} sizes="100vw" />
  </div>

  <div class="wrap inner">
    <h2>Where to <em class="accent caps">start</em></h2>

    <ul class="grid">
      {programs.map(({ label, title, body, cta, href, featured }) => (
        <li class:list={["card", featured && "card--featured"]}>
          <p class="label">
            {featured && (
              <MotionMark size="badge" />
            )}
            {label}
            {featured && (
              <MotionMark size="badge" />
            )}
          </p>

          <h3>{title}</h3>
          <p class="body">{body}</p>

          <Button href={href} size="sm" class="cta">{cta}</Button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .programs {
    position: relative;
    isolation: isolate;
    height: var(--size-programs-height);
    overflow: hidden;
    padding-block: var(--sp-content);
  }

  .backgrounds {
    position: absolute;
    inset: 0;
    height: var(--size-program-bg-height);
    overflow: hidden;
  }

  .backgrounds :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-med);
  }

  h2 { text-align: center; color: var(--color-heading-muted); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-med);
    width: 100%;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: var(--size-principle-card-width);
    height: var(--size-program-card-height);
    text-align: center;
    padding: var(--sp-sm);
    border-radius: var(--radius-feature);
  }

  .card--featured {
    background: var(--color-surface-dark);
    border: var(--sp-thick) solid var(--color-accent);
    box-shadow: var(--shadow-program);
  }

  .label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-xs);
    padding: var(--sp-xxs) var(--sp-xs);
    border: var(--sp-hairline) solid var(--color-accent);
    border-radius: var(--radius-pill);
    font-size: var(--type-body-16);
    line-height: var(--lh-snug);
    color: var(--color-ink-inverse);
  }

  .card h3 {
    margin-top: var(--sp-paragraph);
    font-size: var(--type-h4);
    text-transform: uppercase;
  }

  .body {
    margin-top: var(--sp-paragraph);
    font-size: var(--type-body-18);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .card :global(.cta) { margin-top: auto; }

  @media (max-width: 900px) {
    .programs {
      height: auto;
      padding-block: var(--sp-footer);
    }

    .grid { grid-template-columns: 1fr; }
    .card {
      width: 100%;
      height: auto;
      min-height: var(--size-program-card-height);
    }

    .backgrounds { height: 100%; }
  }
</style>
