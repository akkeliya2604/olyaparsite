<section class="band-dark statement">
  <div class="wrap">
    <p class="line">Ready isn&rsquo;t a feeling</p>
    <p class="line line--strong">It&rsquo;s a practice</p>
  </div>
</section>

<style>
  .statement {
    padding-block: var(--sp-content);
    text-align: center;
  }

  .line {
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-size: clamp(1.75rem, 0.9rem + 3.1vw, 3.25rem);
  }

  /* The second line is set larger in the design, not merely emphasised. */
  .line--strong {
    font-size: clamp(2.125rem, 0.9rem + 4.3vw, 4rem);
    color: var(--color-accent);
  }
</style>
