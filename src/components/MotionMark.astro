---
interface Props {
  size?: "heading" | "badge";
}

const { size = "heading" } = Astro.props;
---

<span class:list={["motion-mark", `motion-mark--${size}`]} aria-hidden="true">
  <img src="/motion-mark-2.svg" alt="" />
</span>

<style>
  .motion-mark {
    position: relative;
    display: inline-block;
    flex: none;
    width: var(--size-mark-width);
    height: var(--size-mark-height);
  }

  .motion-mark--badge {
    width: var(--size-mark-badge-width);
    height: var(--size-mark-badge-height);
  }

  img {
    width: 100%;
    height: 100%;
    transform-origin: var(--pos-mark-origin-x) var(--pos-mark-origin-y);
    animation: mark-loop var(--duration-mark-loop) infinite;
  }

  @keyframes mark-loop {
    0%, 0.058% {
      opacity: 0;
      transform: scale(0.01);
      animation-timing-function: var(--ease-out-back);
    }
    35.31% {
      opacity: 1;
      transform: scale(1);
      animation-timing-function: var(--ease-linear);
    }
    82.36% {
      opacity: 1;
      transform: scale(1);
      animation-timing-function: var(--ease-linear);
    }
    99.94%, 100% {
      opacity: 0;
      transform: scale(0.485);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>
