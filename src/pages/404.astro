---
import BaseLayout from "../layouts/BaseLayout.astro";
// Builds to dist/404.html, which wrangler.jsonc serves via
// assets.not_found_handling = "404-page".
---

<BaseLayout title="Page not found">
  <section class="wrap notfound">
    <p class="code">404</p>
    <h1>That page does not exist.</h1>
    <p class="hint">It may have been renamed or moved.</p>
    <p><a href="/">Back to the homepage &rarr;</a></p>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--prose-width);
    padding-block: var(--space-24);
    text-align: center;
  }
  .code {
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    color: var(--color-text-subtle);
    letter-spacing: 0.2em;
    margin-bottom: var(--space-4);
  }
  .hint { margin-block: var(--space-4) var(--space-8); color: var(--color-text-muted); }
</style>
