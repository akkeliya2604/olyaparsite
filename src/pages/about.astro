---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="Olya Parashuk — product and UX designer."
>
  <article class="wrap about">
    <h1>About</h1>

    <p>
      Placeholder. Replace with a short, specific introduction: what kinds of
      problems you take on, how you work, and what you are looking for next.
      Two or three paragraphs is plenty — the work pages carry the depth.
    </p>

    <h2>Selected skills</h2>
    <ul>
      <li>User research and usability testing</li>
      <li>Interaction design and prototyping</li>
      <li>Design systems and tokens</li>
      <li>Accessibility (WCAG 2.2 AA)</li>
    </ul>

    <h2>Get in touch</h2>
    <p><a href="mailto:hello@example.com">hello@example.com</a></p>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: var(--prose-width);
    padding-block: var(--space-16) var(--space-8);
  }
  .about h2 {
    font-size: var(--size-xl);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }
  .about p { margin-top: var(--space-6); color: var(--color-text-muted); }
  .about ul { color: var(--color-text-muted); padding-left: var(--space-6); }
  .about li { margin-bottom: var(--space-2); }
</style>
