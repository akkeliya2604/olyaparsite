---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Runs at build time: one static HTML file per case study.
export async function getStaticPaths() {
  const projects = await getCollection("work", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="wrap case">
    <header>
      <p class="meta">{project.data.role} &middot; {project.data.year}</p>
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.summary}</p>

      {project.data.tags.length > 0 && (
        <ul class="tags" aria-label="Focus areas">
          {project.data.tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <p class="back"><a href="/work/">&larr; All work</a></p>
  </article>
</BaseLayout>

<style>
  .case {
    max-width: var(--prose-width);
    padding-block: var(--space-16) var(--space-8);
  }

  .meta {
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-3);
  }

  .lede {
    margin-top: var(--space-6);
    font-size: var(--size-lg);
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
  }

  .tags li {
    font-size: var(--size-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2px var(--space-2);
  }

  .prose {
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-12);
  }

  /* :global() because this markup comes from Markdown, so Astro's scoped
     class is not applied to it. */
  .prose :global(h2) {
    font-size: var(--size-xl);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
  }

  .prose :global(blockquote) {
    margin: 0 0 var(--space-8);
    padding: var(--space-4) var(--space-6);
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .back {
    margin-top: var(--space-16);
  }
</style>
